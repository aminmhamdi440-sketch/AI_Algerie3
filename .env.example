# ====================================
# BACKEND ENVIRONMENT VARIABLES
# ====================================

# Database Configuration
DATABASE_URL="file:./dev.db"
# For Production PostgreSQL:
# DATABASE_URL="postgresql://user:password@postgres:5432/titan_enterprise"

# JWT & Security
JWT_SECRET="generate-a-secure-random-key-here-min-32-chars"
NODE_ENV="development"
PORT=3000

# Frontend URL
FRONTEND_URL="http://localhost:3001"

# AI APIs (get your keys from respective platforms)
OPENAI_API_KEY="sk-your-openai-key-here"
DEEPSEEK_API_KEY="your-deepseek-key-here"
ANTHROPIC_API_KEY="your-anthropic-key-here"
GOOGLE_GEMINI_API_KEY="your-gemini-key-here"
GROQ_API_KEY="your-groq-key-here"
TAVILY_API_KEY="your-tavily-key-here"

# Redis (Optional)
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""

# ====================================
# n8n WORKFLOW INTEGRATION
# ====================================
# URL of your running n8n instance (used for routing to specialized agents)
N8N_WEBHOOK_URL="http://localhost:5678/webhook"

# ====================================
# WHATSAPP CLOUD API (Meta)
# ====================================
# Get these from: https://developers.facebook.com → Your App → WhatsApp → API Setup
WHATSAPP_TOKEN="your_permanent_access_token_from_meta"
WHATSAPP_PHONE_NUMBER_ID="your_phone_number_id_from_meta"
# Choose any secret string — set the same value in Meta's webhook config
WHATSAPP_VERIFY_TOKEN="algerie_ai_verify_2024"

# ====================================
# FRONTEND ENVIRONMENT VARIABLES
# ====================================

# API Configuration
NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# Enable/Disable Features
NEXT_PUBLIC_ENABLE_VOICE_INPUT="true"
NEXT_PUBLIC_ENABLE_STORE="true"
NEXT_PUBLIC_ENABLE_LAB="true"

# Analytics (Optional)
NEXT_PUBLIC_ANALYTICS_ID=""
