# =========================
# قاعدة البيانات للإنتاج
# استخدم PostgreSQL أو MySQL
# =========================
DATABASE_URL="postgresql://DB_USER:DB_PASSWORD@DB_HOST:DB_PORT/DB_NAME"

# =========================
# JWT لتأمين التوكنات
# =========================
JWT_SECRET="YOUR_PRODUCTION_SECRET_KEY"

# =========================
# إعدادات السيرفر
# =========================
PORT=3000
NODE_ENV="production"
FRONTEND_URL="https://aialgerie.netlify.app"

# =========================
# مفاتيح API (ضع المفاتيح الحقيقية هنا)
# =========================
OPENAI_API_KEY="YOUR_REAL_OPENAI_KEY"
DEEPSEEK_API_KEY="YOUR_REAL_DEEPSEEK_KEY"
ANTHROPIC_API_KEY="YOUR_REAL_ANTHROPIC_KEY"
GOOGLE_GEMINI_API_KEY="YOUR_REAL_GOOGLE_GEMINI_KEY"
GROQ_API_KEY="YOUR_REAL_GROQ_KEY"
CHARGILY_API_KEY="YOUR_REAL_CHARGILY_KEY"
CHARGILY_API_SECRET="YOUR_REAL_CHARGILY_SECRET"
TAVILY_API_KEY="YOUR_REAL_TAVILY_KEY"

# =========================
# Redis (الإنتاج)
# =========================
REDIS_URL="redis://:REDIS_PASSWORD@REDIS_HOST:6379"

# =========================
# n8n Webhook
# =========================
N8N_WEBHOOK_URL="https://aialgerie.netlify.app/webhook/titan"

# =========================
# CORS / Allowed Origins
# =========================
ALLOWED_ORIGIN="https://aialgerie.netlify.app"
